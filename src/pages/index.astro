---
import '../components/index.css';
import App from '../components/App.jsx';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@400;600;700;900&family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <link rel="preload" href="/logo.svg" as="image" type="image/svg+xml" fetchpriority="high" />
    <link rel="preload" href="/images/hero_poster.webp" as="image" type="image/webp" fetchpriority="high" />
    <meta name="description" content="MO PIZZA — The official pizza of Morad Oudia. Algeria's #1 Slice. 100% Fresh. 100% Hype." />
    <meta name="theme-color" content="#FF5A00" />

    <!-- Open Graph / WhatsApp / Facebook / Instagram -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="MO PIZZA | Le Restaurant Officiel de Morad Oudia" />
    <meta property="og:description" content="Bien plus que de la pizza. Retrouvez nos 5 agences à Alger, Oran, Batna et Mostaganem. 100% Pâte Fraîche Artisanale • 100% Benna." />
    <meta property="og:image" content="/images/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MO PIZZA - Le Restaurant Officiel de Morad Oudia" />
    <meta property="og:site_name" content="MO PIZZA" />
    <meta property="og:locale" content="fr_DZ" />
    <meta property="og:locale:alternate" content="ar_DZ" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="MO PIZZA | Le Restaurant Officiel de Morad Oudia" />
    <meta name="twitter:description" content="Bien plus que de la pizza. Retrouvez nos 5 agences à Alger, Oran, Batna et Mostaganem." />
    <meta name="twitter:image" content="/images/og-image.jpg" />

    <meta name="generator" content={Astro.generator} />
    <title>MO PIZZA | Algeria's #1 Slice</title>
  </head>
  <body>
    <App client:load />
  </body>
</html>
